---
import Base from '../layouts/Base.astro';
import Row from '../components/Row.astro';
import { SITE } from '../lib/site';
---

<Base title={`Contatti — ${SITE.author}`} description="Contattami per parlare di privacy">
  <div class="wrap">
    <Row num="§" label="Contatti" as="header" class="cta">
      <h2 style="margin-top: 24px">Le idee migliori <span class="accent">nascono dal confronto</span></h2>
      <p>Hai una domanda, un'esperienza da condividere o un punto di vista diverso? Non tenerlo per te.</p>
      <a class="email" href={`mailto:${SITE.email}`}>{SITE.email}</a>
    </Row>
  </div>
</Base>
