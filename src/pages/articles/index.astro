---
import Base from '../../layouts/Base.astro';
import Row from '../../components/Row.astro';
import ArticleIndex from '../../components/ArticleIndex.astro';
import { SITE, getArticles } from '../../lib/site';

const articles = await getArticles();
const tags = [...new Set(articles.flatMap((a) => a.data.tags))].sort((a, b) => a.localeCompare(b, 'it'));
---

<Base
  title={`Articoli — ${SITE.author}`}
  description="Approfondimenti su GDPR, AI Act europeo, e nuove frontiere della privacy digitale."
>
  <div class="wrap">
    <Row num="§" label="Archivio" class="row--tight" as="header">
      <h1 class="title-lg">Articoli</h1>
      <p class="lede">Tutto quello che ho scritto finora.</p>
    </Row>

    <Row label={`${articles.length} articoli`} class="row--tight">
      {tags.length > 0 && (
        <div class="filters" role="group" aria-label="Filtra per tag">
          <button type="button" data-tag="" aria-pressed="true">Tutti</button>
          {tags.map((t) => <button type="button" data-tag={t} aria-pressed="false">{t}</button>)}
        </div>
      )}
      <ArticleIndex articles={articles} />
    </Row>
  </div>

  <script is:inline>
    (() => {
      const bar = document.querySelector('.filters');
      if (!bar) return;
      const buttons = [...bar.querySelectorAll('button')];
      const items = [...document.querySelectorAll('.index > li')];
      bar.classList.add('is-ready');
      bar.addEventListener('click', (e) => {
        const btn = e.target.closest('button');
        if (!btn) return;
        const tag = btn.dataset.tag;
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        items.forEach((li) => {
          li.hidden = Boolean(tag) && !JSON.parse(li.dataset.tags || '[]').includes(tag);
        });
      });
    })();
  </script>
</Base>
