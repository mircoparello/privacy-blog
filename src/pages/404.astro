---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="Not found — Francesca Bucci" description="Page not found.">
  <div class="notfound">
    <div>
      <div class="notfound__code">404</div>
      <h1>This page doesn't exist.</h1>
      <p>Maybe it was redacted. Maybe it never was. Either way —</p>
      <a href={`${base}/`} class="btn btn-primary">Back home →</a>
    </div>
  </div>
</Base>
