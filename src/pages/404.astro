---
import Base from '../layouts/Base.astro';
import Row from '../components/Row.astro';
import { SITE, url } from '../lib/site';
---

<Base title={`Pagina non trovata — ${SITE.author}`} description="Pagina non trovata.">
  <div class="wrap">
    <Row num="§ 404" label="Non trovata" as="header">
      <p class="code-404" aria-hidden="true">404</p>
      <h1 class="h2" style="margin-top: 16px">Questa pagina non esiste.</h1>
      <p class="lede">Forse è stata oscurata. Forse non è mai esistita. In ogni caso —</p>
      <div class="actions">
        <a class="btn btn--solid" href={url('/')}>Torna alla home →</a>
      </div>
    </Row>
  </div>
</Base>
