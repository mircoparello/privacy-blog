---
import Base from '../layouts/Base.astro';
import Row from '../components/Row.astro';
import ArticleIndex from '../components/ArticleIndex.astro';
import { SITE, url, articleUrl, getArticles, formatDateShort, readingTime } from '../lib/site';

const articles = await getArticles();
const featured = articles.find((a) => a.data.featured) ?? articles[0];
const rest = articles.filter((a) => a.id !== featured?.id).slice(0, 4);

const interests = [
  'Cultura della privacy',
  'Etica dei dati',
  'Libertà e riservatezza',
  'Consapevolezza digitale',
];
---

<Base title={SITE.name}>
  <div class="wrap">
    <Row num="§ 0" label="Premessa">
      <h1 class="display">Domande umane su <em>questioni digitali.</em></h1>
      <ul class="interests" aria-label="Aree di interesse">
        {interests.map((i) => <li>{i}</li>)}
      </ul>
      <div class="actions">
        <a class="btn btn--solid" href={url('/articles')}>Leggi gli articoli →</a>
        <a class="btn" href={url('/contact')}>Scrivimi</a>
      </div>
    </Row>

    {featured && (
      <Row num="§ 1" label="In evidenza">
        <h2 class="h2">Una nuova impressione</h2>
        <article class="featured">
          <div>
            <h3><a href={articleUrl(featured)}>{featured.data.title}</a></h3>
            <p>{featured.data.description}</p>
            <a class="more" href={articleUrl(featured)}>Leggi l'articolo →</a>
          </div>
          <dl class="meta">
            <dt>Data</dt><dd><time datetime={featured.data.pubDate.toISOString()}>{formatDateShort(featured.data.pubDate)}</time></dd>
            <dt>Tema</dt><dd>{featured.data.topic}</dd>
            <dt>Lettura</dt><dd>{readingTime(featured)}</dd>
          </dl>
        </article>
      </Row>
    )}

    {rest.length > 0 && (
      <Row num="§ 2" label="Articoli recenti">
        <h2 class="h2">Altre impressioni</h2>
        <ArticleIndex articles={rest} prefix="2." />
        <a class="more" href={url('/articles')}>Tutti gli articoli →</a>
      </Row>
    )}

    <Row num="§ 3" label="Contatti" class="cta">
      <h2>Le idee migliori, nascono dal confronto</h2>
      <p>Hai una domanda, un'esperienza da condividere o un punto di vista diverso? Non tenerlo per te.</p>
      <a class="email" href={`mailto:${SITE.email}`}>{SITE.email}</a>
    </Row>
  </div>
</Base>
